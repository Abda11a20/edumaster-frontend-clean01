{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.youtube.com https://s.ytimg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; frame-src 'self' https://www.youtube.com https://accept.paymob.com https://accept.paymobsolutions.com; img-src 'self' data: https:; connect-src 'self' https://edu-master-delta.vercel.app;"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/auth",               "destination": "https://edu-master-delta.vercel.app/auth" },
    { "source": "/auth/:path*",        "destination": "https://edu-master-delta.vercel.app/auth/:path*" },
    { "source": "/user",               "destination": "https://edu-master-delta.vercel.app/user" },
    { "source": "/user/:path*",        "destination": "https://edu-master-delta.vercel.app/user/:path*" },
    { "source": "/lesson",             "destination": "https://edu-master-delta.vercel.app/lesson" },
    { "source": "/lesson/:path*",      "destination": "https://edu-master-delta.vercel.app/lesson/:path*" },
    { "source": "/exam",               "destination": "https://edu-master-delta.vercel.app/exam" },
    { "source": "/exam/:path*",        "destination": "https://edu-master-delta.vercel.app/exam/:path*" },
    { "source": "/question",           "destination": "https://edu-master-delta.vercel.app/question" },
    { "source": "/question/:path*",    "destination": "https://edu-master-delta.vercel.app/question/:path*" },
    { "source": "/admin",              "destination": "https://edu-master-delta.vercel.app/admin" },
    { "source": "/admin/:path*",       "destination": "https://edu-master-delta.vercel.app/admin/:path*" },
    { "source": "/studentExam",        "destination": "https://edu-master-delta.vercel.app/studentExam" },
    { "source": "/studentExam/:path*", "destination": "https://edu-master-delta.vercel.app/studentExam/:path*" },
    { "source": "/(.*)",               "destination": "/index.html" }
  ]
}
